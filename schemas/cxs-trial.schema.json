{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jimmyjames177414/errorbars/schemas/cxs-trial.schema.json",
  "title": "CXS Trial v0.1",
  "description": "One execution. Raw, never aggregated in place. One per line of trials.jsonl, which is append-only and never rewritten.",
  "type": "object",
  "required": ["trial_id", "intervention_id", "item_id", "response_text"],
  "properties": {
    "trial_id": { "type": "string", "minLength": 1 },
    "experiment_id": { "type": "string" },
    "intervention_id": { "type": "string", "minLength": 1 },
    "item_id": { "type": "string", "minLength": 1 },
    "repeat_index": { "type": "integer", "minimum": 0 },
    "model": { "$ref": "cxs-model-descriptor.schema.json" },
    "prompt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Hash rather than the prompt itself, so a results directory can be shared without leaking the dataset."
    },
    "response_text": { "type": "string" },
    "cached": { "type": "boolean" },
    "latency_ms": { "type": "integer", "minimum": 0 },
    "usage": {
      "type": "object",
      "properties": {
        "prompt_tokens": { "type": "integer", "minimum": 0 },
        "completion_tokens": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "error": { "type": ["string", "null"] },
    "observed_at": { "type": "string" }
  },
  "additionalProperties": true
}
